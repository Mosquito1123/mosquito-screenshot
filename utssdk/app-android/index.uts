import Bitmap from 'android.graphics.Bitmap'
import BitmapFactory from 'android.graphics.BitmapFactory'
import Canvas from 'android.graphics.Canvas'
import CompressFormat from 'android.graphics.Bitmap.CompressFormat'
import File from 'java.io.File'
import FileOutputStream from 'java.io.FileOutputStream'
import Handler from 'android.os.Handler'
import Looper from 'android.os.Looper'
import PixelCopy from 'android.view.PixelCopy'
import View from 'android.view.View'
import Build from 'android.os.Build'
import { MqCaptureFailImpl } from '../unierror.uts'
import {
  MqCaptureFormat,
  MqCaptureResult,
  MqCaptureScreen,
  MqCaptureScreenOptions,
  MqStitchImages,
  MqStitchImagesOptions,
} from '../interface.uts'

function resolveFormat(format : MqCaptureFormat | null) : MqCaptureFormat {
  return format == 'jpg' ? 'jpg' : 'png'
}

function resolveQuality(quality : number | null) : number {
  if (quality == null || quality < 1) {
    return 90
  }
  if (quality > 100) {
    return 100
  }
  return quality
}

function createOutFile(format : MqCaptureFormat) : File {
  const dir = UTSAndroid.getAppContext()!.getCacheDir()
  const name = `mq_shot_${Date.now()}_${Math.floor(Math.random() * 10000)}.${format}`
  return new File(dir, name)
}

function saveBitmap(bitmap : Bitmap, format : MqCaptureFormat, quality : number) : MqCaptureResult | null {
  const file = createOutFile(format)
  let stream : FileOutputStream | null = null
  try {
    stream = new FileOutputStream(file)
    const ok = bitmap.compress(
      format == 'jpg' ? CompressFormat.JPEG : CompressFormat.PNG,
      format == 'jpg' ? quality : 100,
      stream!
    )
    stream!.flush()
    if (!ok) {
      return null
    }
    return {
      path: file.getAbsolutePath(),
      width: bitmap.getWidth(),
      height: bitmap.getHeight(),
    } as MqCaptureResult
  } catch (e) {
    return null
  } finally {
    try {
      stream?.close()
    } catch (closeError) {
      // ignore
    }
  }
}

function drawViewBitmap(view : View) : Bitmap | null {
  const width = view.getWidth()
  const height = view.getHeight()
  if (width <= 0 || height <= 0) {
    return null
  }
  const bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
  const canvas = new Canvas(bitmap)
  view.draw(canvas)
  return bitmap
}

function captureWithPixelCopy(view : View, callback : (bitmap : Bitmap | null) => void) {
  const width = view.getWidth()
  const height = view.getHeight()
  if (width <= 0 || height <= 0) {
    callback(null)
    return
  }
  const bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
  try {
    const window = UTSAndroid.getUniActivity()!.getWindow()
    PixelCopy.request(window!, bitmap, (copyResult : Int) => {
      if (copyResult == PixelCopy.SUCCESS) {
        callback(bitmap)
      } else {
        callback(drawViewBitmap(view))
      }
    }, new Handler(Looper.getMainLooper()))
  } catch (e) {
    callback(drawViewBitmap(view))
  }
}

function finishFail(options : MqCaptureScreenOptions | MqStitchImagesOptions, code : number) {
  const err = new MqCaptureFailImpl(code as any)
  options.fail?.(err)
  options.complete?.(err)
}

function finishOk(options : MqCaptureScreenOptions | MqStitchImagesOptions, result : MqCaptureResult) {
  options.success?.(result)
  options.complete?.(result)
}

export const captureScreen : MqCaptureScreen = function (options : MqCaptureScreenOptions) {
  const format = resolveFormat(options.format ?? null)
  const quality = resolveQuality(options.quality ?? null)
  const activity = UTSAndroid.getUniActivity()
  if (activity == null) {
    finishFail(options, 9011003)
    return
  }
  const view = activity!.getWindow()!.getDecorView()
  const run = () => {
    if (Build.VERSION.SDK_INT >= 26) {
      captureWithPixelCopy(view, (bitmap : Bitmap | null) => {
        if (bitmap == null) {
          finishFail(options, 9011003)
          return
        }
        const result = saveBitmap(bitmap!, format, quality)
        if (result == null) {
          finishFail(options, 9011005)
          return
        }
        finishOk(options, result!)
      })
      return
    }
    const bitmap = drawViewBitmap(view)
    if (bitmap == null) {
      finishFail(options, 9011003)
      return
    }
    const result = saveBitmap(bitmap!, format, quality)
    if (result == null) {
      finishFail(options, 9011005)
      return
    }
    finishOk(options, result!)
  }
  view.post(run)
}

export const stitchImages : MqStitchImages = function (options : MqStitchImagesOptions) {
  const paths = options.paths
  if (paths.length == 0) {
    finishFail(options, 9011002)
    return
  }
  const format = resolveFormat(options.format ?? null)
  const quality = resolveQuality(options.quality ?? null)
  try {
    const bitmaps = new Array<Bitmap>()
    let width = 0
    let totalHeight = 0
    for (let i = 0; i < paths.length; i++) {
      const path = paths[i]
      const bmp = BitmapFactory.decodeFile(path)
      if (bmp == null) {
        finishFail(options, 9011004)
        return
      }
      const cropTop = options.sliceOffsets != null && options.sliceOffsets!.length > i
        ? Math.max(0, options.sliceOffsets![i])
        : 0
      let keep = options.sliceHeights != null && options.sliceHeights!.length > i
        ? Math.max(1, options.sliceHeights![i])
        : bmp!.getHeight() - cropTop
      if (cropTop + keep > bmp!.getHeight()) {
        keep = bmp!.getHeight() - cropTop
      }
      if (keep <= 0) {
        finishFail(options, 9011004)
        return
      }
      const slice = Bitmap.createBitmap(bmp!, 0, cropTop, bmp!.getWidth(), keep)
      bitmaps.push(slice)
      width = Math.max(width, slice.getWidth())
      totalHeight += slice.getHeight()
    }
    if (width <= 0 || totalHeight <= 0) {
      finishFail(options, 9011004)
      return
    }
    const out = Bitmap.createBitmap(width, totalHeight, Bitmap.Config.ARGB_8888)
    const canvas = new Canvas(out)
    let top = 0
    for (let i = 0; i < bitmaps.length; i++) {
      const item = bitmaps[i]
      canvas.drawBitmap(item, 0.0, top.toFloat(), null)
      top += item.getHeight()
    }
    const result = saveBitmap(out, format, quality)
    if (result == null) {
      finishFail(options, 9011005)
      return
    }
    finishOk(options, result!)
  } catch (e) {
    finishFail(options, 9011004)
  }
}
